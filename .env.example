EVIDENCEOPS_PROVIDER=demo
EVIDENCEOPS_DATA_DIR=data
EVIDENCEOPS_MAX_UPLOAD_MB=20
EVIDENCEOPS_REQUESTS_PER_MINUTE=30
EVIDENCEOPS_PROVIDER_RETRIES=2
EVIDENCEOPS_CIRCUIT_FAILURE_THRESHOLD=3
EVIDENCEOPS_CIRCUIT_COOLDOWN_SECONDS=30
EVIDENCEOPS_TOOL_CALLS_PER_MINUTE=60
EVIDENCEOPS_TOOL_CACHE_TTL_SECONDS=300

# OpenAI-compatible provider placeholders
OPENAI_COMPATIBLE_BASE_URL=https://BASE_URL/v1
OPENAI_COMPATIBLE_API_KEY=API_KEY
OPENAI_COMPATIBLE_MODEL=MODEL_ID

# Optional Amazon Bedrock provider
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=MODEL_ID
